SECRET_KEY=django-insecure-example-key-replace-me
DEBUG=True

# Para usar PostgreSQL, descomente a linha abaixo e preencha suas credenciais
# DATABASE_URL=postgres://usuario:senha@127.0.0.1:5432/nome_do_banco

# Produção (no Render estas variáveis vêm do render.yaml)
# ALLOWED_HOSTS=meudominio.com.br
# CSRF_TRUSTED_ORIGINS=https://meudominio.com.br
# MEDIA_ROOT=/var/data/media

# E-mail para recuperação de senha (sem isto, os e-mails aparecem só no log)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=seu@email.com
# EMAIL_HOST_PASSWORD=senha-de-app
# DEFAULT_FROM_EMAIL=FonoGestão <seu@email.com>
